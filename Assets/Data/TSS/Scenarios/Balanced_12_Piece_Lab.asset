  networkScenario:
    enableLayer23Simulation: 1
    profileSeed: 20261008
    managementVlanName: Management
    receptionVlanName: Reception
    dataVlanName: Data
    nativeVlanName: Native
    deadVlanName: Dead_Vlan
    dhcpNetworkNames:
    - Reception
    vlanMinimum: 10
    vlanMaximum: 390
    endpointAliases:
    - IT1
    - IT2
    - Reception1
    - Reception2
    - Data1
    - Data2
    - Data3
    - AP-1
    roleBindings:
    - role: AN-1
      deviceKey: Rack:Rack01:U35
      category: 1
      displayName: AN-1
    - role: AN-2
      deviceKey: Rack:Rack02:U35
      category: 1
      displayName: AN-2
    - role: CN-1
      deviceKey: Rack:Rack01:U30
      category: 0
      displayName: CN-1
    requiredPorts:
    - deviceRole: AN-1
      interfaceName: Fa0/2
      endpointId: IT1
    - deviceRole: AN-1
      interfaceName: Fa0/3
      endpointId: Reception1
    - deviceRole: AN-1
      interfaceName: Fa0/4
      endpointId: Reception2
    - deviceRole: AN-1
      interfaceName: Fa0/5
      endpointId: IT2
    - deviceRole: AN-2
      interfaceName: Fa0/2
      endpointId: Data1
    - deviceRole: AN-2
      interfaceName: Fa0/3
      endpointId: Data2
    - deviceRole: AN-2
      interfaceName: Fa0/4
      endpointId: Data3
    evidenceRequirements:
    - evidenceId: IT1-provider
      command: ping provider
      description: Endpoint-originated provider diagnostic
  binderReference:
    namingAndRacks:
      sectionTitle: Naming & Racks
      scenarioHeading: NAMING & RACKS - {ScenarioId}
      intro: AN = Access Node (switch). CN = Core Node (router). Rack order is not cosmetic; power stays at the top, the patch panel sits directly above the switch it feeds, the router sits below its uplink switch, and the heavy box stays lowest for stability.
    vlans:
      sectionTitle: VLANs
      scenarioHeading: VLAN ASSIGNMENT - {ScenarioId}
      intro: These IDs are yours. Build this database on both switches; VLAN databases are locally significant, so AN-2 will not learn AN-1's VLANs across the trunk.
      endingParagraph: 'Trunk (Fa0/1 both switches): 802.1Q, allowed {ManagementVlan},{ReceptionVlan},{DataVlan}, native {NativeVlan}. Every unused port: access VLAN {DeadVlan} + shutdown.'
    ipPlan:
      sectionTitle: IP Plan
      scenarioHeading: ADDRESSING PLAN - {ScenarioId}
      hostAddressesHeading: HOST ADDRESSES
      paragraph: All networks are /24. The gateway is always .1 and lives on a CN-1 sub-interface, never on a switch.
    cableSchedule:
      sectionTitle: Cable Schedule
      scenarioHeading: CABLE RUN SCHEDULE - {ScenarioId}
      introParagraph: Punch-downs are permanent copper through walls and ceiling. Patch cords are field-replaceable. Cable type identifies the expected connection class.
    circuitLetter:
      sectionTitle: CIRCUIT HANDOFF LETTER
      scenarioHeading: CIRCUIT LETTER - {ScenarioId}
      intro: Tapped to the NID on the IT room wall. The only place your WAN addressing
        appears, so you never configure the provider side.
      note: Customer shall install a default route toward {WanProviderAddress}.
      rows:
      - label: Circuit ID
        value: '{CircuitId}'
      - label: Provider side
        value: '{WanProviderAddress} /30'
      - label: Customer side
        value: '{WanCustomerAddress} /30'
      - label: Mask
        value: 255.255.255.252
    wireless:
      sectionTitle: WIRELESS AP CONFIG SHEET
      scenarioHeading: WIRELESS - {ScenarioId}
      intro: The WAP mounts on the Guest Lounge ceiling and lands on a spare switchport
        in the {ReceptionVlanName} VLAN. Configure it from IT1's browser at its management
        IP.
      note: 1, 6, and 11 are the only non-overlapping 2.4 GHz channels in North America.
        Use the assigned channel, disable WPS, and change the AP admin password.
      rows:
      - label: AP name
        value: WAP1
      - label: SSID
        value: '{Ssid}'
      - label: Security
        value: WPA2-PSK (AES)
      - label: Passphrase
        value: '{WifiPassphrase}'
      - label: Channel
        value: '{WirelessChannel} (2.4 GHz)'
      - label: WPS
        value: DISABLED
      - label: Admin password
        value: '{ApAdminPassword}'
      - label: Uplink VLAN
        value: '{ReceptionVlanName} (VLAN {ReceptionVlan})'
      - label: Management IP
        value: '{ApManagementAddress}'
      - label: Broadcast SSID
        value: Enabled
    credentials:
      sectionTitle: Credentials
      scenarioHeading: CREDENTIALS - {ScenarioId}
      intro: Apply identically to AN-1, AN-2, and CN-1. These values are generated
        for the current training run.
      note: The banner is a legal requirement, not decoration. Without it, prosecuting
        unauthorized access gets much harder.
      rows:
      - label: Console password
        value: '{ConsolePassword}'
      - label: VTY password
        value: '{VtyPassword}'
      - label: Enable secret
        value: '{EnableSecret}'
      - label: Local user
        value: admin / 12#$Qwert
      - label: Login banner
        value: '{Motd}'
      - label: Password encryption
        value: service password-encryption
      - label: Domain lookup
        value: no ip domain-lookup
