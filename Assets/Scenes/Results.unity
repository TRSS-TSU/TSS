  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 15
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "===== SHOW RUNNING-CONFIG =====\nversion 15.0\n!\nhostname AN-1\nservice
    password-encryption\nno ip domain-lookup\n!\ninterface Fa0/1\n switchport mode
    trunk\n switchport trunk allowed vlan 10,20,30\n switchport trunk native vlan
    99\n!\ninterface Fa0/7\n switchport mode access\n switchport access vlan 20\n
    shutdown\n!\ninterface Vlan1\n ip address 10.24.10.2 255.255.255.0\n!\nline vty
    0 4\n login\n!\nend\n\n===== SHOW VLAN BRIEF =====\nVLAN Name                            
    Status    Ports\n---- -------------------------------- --------- -------------------------------\n1   
    default                          active    \n10   Management                      
    active    \n20   Reception                        active    Fa0/7\n30   Data                            
    active    \n99   Native                           active    \n999  Dead_Vlan                       
    suspended\n\n===== SHOW INTERFACES TRUNK =====\nFa0/1 on 802.1q trunking\nNative
    vlan: 99\nVlans allowed on trunk: 10,20,30\n\n===== SHOW IP INTERFACE BRIEF =====\nInterface                 
    IP-Address      Status                Protocol\nVlan1                      10.24.10.2     
    up                    up\nFa0/1                      unassigned      up                   
    up\nFa0/7                      unassigned      administratively down down\n\n=====
    SHOW MAC ADDRESS-TABLE =====\nMac Address Table\n(no dynamic entries until endpoints
    are reachable)\n"
